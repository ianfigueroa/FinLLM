OPENAI_API_KEY=
FINLLM_MODEL=gpt-4.1-mini
FINLLM_VECTOR_BACKEND=memory
FINLLM_STORAGE_DIR=storage
FINLLM_MAX_UPLOAD_MB=10

# Optional generative answer provider.
# Default local mode is deterministic and does not call an LLM.
# Supported: local, ollama, openai-compatible
FINLLM_LLM_PROVIDER=local
FINLLM_LLM_MODEL=
FINLLM_LLM_BASE_URL=
FINLLM_LLM_API_KEY=
